<resources>
    <style name="Theme.Nexus" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#060C17</item>
        <item name="android:statusBarColor">#060C17</item>
        <item name="android:navigationBarColor">#060C17</item>
    </style>
    <style name="Theme.Nexus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/toruva_icon_background</item>
        <item name="android:statusBarColor">@color/toruva_icon_background</item>
        <item name="android:navigationBarColor">@color/toruva_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexus</item>
    </style>
</resources>
